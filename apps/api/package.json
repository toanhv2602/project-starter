{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:export": "node -r @swc-node/register src/openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../../.env -- node -r @swc-node/register prisma/seed.ts",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:check": "dotenv -e ../../.env -- prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "nestjs-zod": "^5.6.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.4",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "typescript": "~5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.0"
  }
}
