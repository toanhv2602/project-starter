# Copy to .env (`pnpm onboard` does this and generates secrets for you).
# Every variable is validated at startup: apps/api/src/config/env.ts, apps/worker/src/env.ts
NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=3000
# Comma-separated list. In dev the web app uses the Vite proxy, so CORS is only needed
# when the SPA is served from a different origin than the API.
WEB_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
# true behind HTTPS (staging/production). Controls the Secure flag on the refresh cookie.
COOKIE_SECURE=false
# "true", "false" or proxy IPs/CIDRs in front of the API (needed for real client IPs).
TRUST_PROXY=false

# --- Data stores ---
# Host ports used by docker-compose.yml (pnpm onboard picks free ones automatically).
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/app_db?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth --- (at least 32 characters each, must be different)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-aaaa
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-bbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Web (build-time, exposed to the browser: never put secrets here) ---
VITE_API_BASE_URL=
