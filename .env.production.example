# Copy to .env.production on the server (never commit it). Prefer a secret manager.
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
WEB_ORIGIN=https://app.example.com
SWAGGER_ENABLED=false
# Requires HTTPS in front of the web container. Set false only for a local HTTP trial.
COOKIE_SECURE=true
# nginx (web container) is the only proxy in front of the API.
TRUST_PROXY=true
WEB_PORT=8080

POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=app_db
DATABASE_URL=postgresql://app:CHANGE_ME_long_random_password@postgres:5432/app_db?schema=public
REDIS_URL=redis://redis:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_random_value_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

IMAGE_PREFIX=app
IMAGE_TAG=local
