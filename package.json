{
  "name": "full-node-starter",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "simple-git-hooks || true",
    "dev": "pnpm build:packages && pnpm --parallel --filter @app/web --filter @app/api --filter @app/worker --filter @app/contracts dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r --filter=!@app/e2e test",
    "test:e2e": "pnpm --filter @app/e2e test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @app/api prisma:generate",
    "db:migrate:dev": "pnpm --filter @app/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @app/api prisma:migrate:deploy",
    "db:check": "pnpm --filter @app/api prisma:check",
    "db:seed": "pnpm --filter @app/api prisma:seed",
    "api:generate": "pnpm --filter @app/api openapi:export && pnpm --filter @app/api-client generate",
    "onboard": "node scripts/onboard.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,mts,cts,vue,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
